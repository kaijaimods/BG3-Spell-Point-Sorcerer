local __util = require 'larian.util'

function KJCanSorceryCast()
    return HasUseCosts('SpellSlot') & HasSpellFlag(SpellFlags.Spell) & (IsSpellLevel(1) | IsSpellLevel(2) | IsSpellLevel(3) | IsSpellLevel(4) | IsSpellLevel(5))
end

function KJSorceryCastLow()
	return (SpellId('Zone_BurningHands') | SpellId('Zone_BurningHands_2') | SpellId('Target_CharmPerson') | SpellId('Target_CharmPerson_2') | SpellId('Projectile_ChromaticOrb') | SpellId('Projectile_ChromaticOrb_2') | SpellId('Zone_ColorSpray') | SpellId('Zone_ColorSpray_2') | SpellId('Shout_DisguiseSelf') | SpellId('Shout_DisguiseSelf_2') | SpellId('Shout_ExpeditiousRetreat') | SpellId('Shout_ExpeditiousRetreat_2') | SpellId('Shout_FalseLife') | SpellId('Shout_FalseLife_2') | SpellId('Shout_FeatherFall') | SpellId('Shout_FeatherFall_2') | SpellId('Target_FogCloud') | SpellId('Target_FogCloud_2') | SpellId('Projectile_IceKnife') | SpellId('Projectile_IceKnife_2') | SpellId('Target_Jump') | SpellId('Target_Jump_2') | SpellId('Target_MageArmor') | SpellId('Target_MageArmor_2') | SpellId('Projectile_MagicMissile') | SpellId('Projectile_MagicMissile_2') | SpellId('Projectile_RayOfSickness') | SpellId('Projectile_RayOfSickness_2') | SpellId('Shout_Shield_Sorcerer') | SpellId('Target_Sleep') | SpellId('Target_Sleep_2') | SpellId('Zone_Thunderwave') | SpellId('Zone_Thunderwave_2') | SpellId('Projectile_WitchBolt') | SpellId('Projectile_WitchBolt_2') | SpellId('Target_Blindness') | SpellId('Shout_Blur') | SpellId('Target_CloudOfDaggers') | SpellId('Target_CrownOfMadness') | SpellId('Target_Darkness') | SpellId('Target_Darkvision') | SpellId('Shout_DetectThoughts') | SpellId('Target_EnhanceAbility') | SpellId('Target_EnlargeReduce') | SpellId('Zone_GustOfWind') | SpellId('Target_HoldPerson') | SpellId('Target_Invisibility') | SpellId('Target_Knock') | SpellId('Shout_MirrorImage') | SpellId('Target_MistyStep') | SpellId('Target_PhantasmalForce') | SpellId('Projectile_ScorchingRay') | SpellId('Shout_SeeInvisibility') | SpellId('Target_Shatter') | SpellId('Target_Web') | SpellId('Shout_ArmorOfAgathys') | SpellId('Shout_ArmorOfAgathys_2') | SpellId('Target_CreateDestroyWater') | SpellId('Target_CreateDestroyWater_2') | SpellId('Target_Grease') | SpellId('Target_Grease_2') | SpellId('Target_HideousLaughter') | SpellId('Target_HideousLaughter_2'))
end