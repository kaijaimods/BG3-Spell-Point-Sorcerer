local __util = require 'larian.util'

function KJCanSorceryCast()
    return HasUseCosts('SpellSlot') & HasSpellFlag(SpellFlags.Spell) & (IsSpellLevel(1) | IsSpellLevel(2) | IsSpellLevel(3) | IsSpellLevel(4) | IsSpellLevel(5))
end

function KJSorceryCastLow()
	return (SpellId('Zone_BurningHands') | SpellId('Zone_BurningHands_2') | SpellId('Target_CharmPerson') | SpellId('Target_CharmPerson_2') | KJSorceryChromaticOrbLow() | SpellId('Zone_ColorSpray') | SpellId('Zone_ColorSpray_2') | KJSorceryDisguiseSelf() | SpellId('Shout_ExpeditiousRetreat') | SpellId('Shout_ExpeditiousRetreat_2') | SpellId('Shout_FalseLife') | SpellId('Shout_FalseLife_2') | SpellId('Shout_FeatherFall') | SpellId('Shout_FeatherFall_2') | SpellId('Target_FogCloud') | SpellId('Target_FogCloud_2') | SpellId('Projectile_IceKnife') | SpellId('Projectile_IceKnife_2') | SpellId('Target_Jump') | SpellId('Target_Jump_2') | SpellId('Target_MageArmor') | SpellId('Target_MageArmor_2') | SpellId('Projectile_MagicMissile') | SpellId('Projectile_MagicMissile_2') | SpellId('Projectile_RayOfSickness') | SpellId('Projectile_RayOfSickness_2') | SpellId('Shout_Shield_Sorcerer') | SpellId('Target_Sleep') | SpellId('Target_Sleep_2') | SpellId('Zone_Thunderwave') | SpellId('Zone_Thunderwave_2') | SpellId('Projectile_WitchBolt') | SpellId('Projectile_WitchBolt_2') | SpellId('Target_Blindness') | SpellId('Shout_Blur') | SpellId('Target_CloudOfDaggers') | SpellId('Target_CrownOfMadness') | SpellId('Target_Darkness') | SpellId('Target_Darkvision') | SpellId('Shout_DetectThoughts') | KJSorceryEnhanceAbility() | SpellId('Target_EnlargeReduce') | SpellId('Target_Enlarge') | SpellId('Target_Reduce') | SpellId('Zone_GustOfWind') | SpellId('Target_HoldPerson') | SpellId('Target_Invisibility') | SpellId('Target_Knock') | SpellId('Shout_MirrorImage') | SpellId('Target_MistyStep') | SpellId('Target_PhantasmalForce') | SpellId('Projectile_ScorchingRay') | SpellId('Shout_SeeInvisibility') | SpellId('Target_Shatter') | SpellId('Shout_ShadowBlade_Class') | SpellId('Target_Web') | SpellId('Shout_ArmorOfAgathys') | SpellId('Shout_ArmorOfAgathys_2') | SpellId('Target_CreateDestroyWater') | SpellId('Target_CreateWater') | SpellId('Target_DestroyWater') | SpellId('Target_CreateDestroyWater_2') | SpellId('Target_CreateWater_2') | SpellId('Target_DestroyWater_2') | SpellId('Target_Grease') | SpellId('Target_Grease_2') | SpellId('Target_HideousLaughter') | SpellId('Target_HideousLaughter_2') | KJSorcery5ESpellsLow())
end

function KJSorceryChromaticOrbLow()
	return (SpellId('Projectile_ChromaticOrb') | SpellId('Projectile_ChromaticOrb_Acid') | SpellId('Projectile_ChromaticOrb_Cold') | SpellId('Projectile_ChromaticOrb_Fire') | SpellId('Projectile_ChromaticOrb_Lightning') | SpellId('Projectile_ChromaticOrb_Poison') | SpellId('Projectile_ChromaticOrb_Thunder') | SpellId('Projectile_ChromaticOrb_2') | SpellId('Projectile_ChromaticOrb_Acid_2') | SpellId('Projectile_ChromaticOrb_Cold_2') | SpellId('Projectile_ChromaticOrb_Fire_2') | SpellId('Projectile_ChromaticOrb_Lightning_2') | SpellId('Projectile_ChromaticOrb_Poison_2') | SpellId('Projectile_ChromaticOrb_Thunder_2'))
end

function KJSorceryDisguiseSelf()
	return (SpellId('Shout_DisguiseSelf') | SpellId('Shout_DisguiseSelf_Tiefling_Male') | SpellId('Shout_DisguiseSelf_Tiefling_Female') | SpellId('Shout_DisguiseSelf_Drow_Male') | SpellId('Shout_DisguiseSelf_Drow_Female') | SpellId('Shout_DisguiseSelf_Human_Male') | SpellId('Shout_DisguiseSelf_Human_Female') | SpellId('Shout_DisguiseSelf_Githyanki_Male') | SpellId('Shout_DisguiseSelf_Githyanki_Female') | SpellId('Shout_DisguiseSelf_Dwarf_Male') | SpellId('Shout_DisguiseSelf_Dwarf_Female') | SpellId('Shout_DisguiseSelf_Elf_Male') | SpellId('Shout_DisguiseSelf_Elf_Female') | SpellId('Shout_DisguiseSelf_HalfElf_Male') | SpellId('Shout_DisguiseSelf_HalfElf_Female') | SpellId('Shout_DisguiseSelf_Halfling_Male') | SpellId('Shout_DisguiseSelf_Halfling_Female') | SpellId('Shout_DisguiseSelf_Dragonborn_Male') | SpellId('Shout_DisguiseSelf_Dragonborn_Female') | SpellId('Shout_DisguiseSelf_HalfOrc_Male') | SpellId('Shout_DisguiseSelf_HalfOrc_Female') | SpellId('Shout_DisguiseSelf_Gnome_Male') | SpellId('Shout_DisguiseSelf_Gnome_Female') | SpellId('Shout_DisguiseSelf_Human_Strong_Male') | SpellId('Shout_DisguiseSelf_Human_Strong_Female') | SpellId('Shout_DisguiseSelf_Drow_Strong_Male') | SpellId('Shout_DisguiseSelf_Drow_Strong_Female') | SpellId('Shout_DisguiseSelf_Elf_Strong_Male') | SpellId('Shout_DisguiseSelf_Elf_Strong_Female') | SpellId('Shout_DisguiseSelf_HalfElf_Strong_Male') | SpellId('Shout_DisguiseSelf_HalfElf_Strong_Female') | SpellId('Shout_DisguiseSelf_Tiefling_Strong_Male') | SpellId('Shout_DisguiseSelf_Tiefling_Strong_Female'))
end

function KJSorceryEnhanceAbility()
	return (SpellId('Target_EnhanceAbility') | SpellId('Target_EnhanceAbility_BearsEndurance') | SpellId('Target_EnhanceAbility_BullsStrength') | SpellId('Target_EnhanceAbility_CatsGrace') | SpellId('Target_EnhanceAbility_EaglesSplendor') | SpellId('Target_EnhanceAbility_FoxsCunning') | SpellId('Target_EnhanceAbility_OwlsWisdom'))
end

function KJSorcery5ESpellsLow()
	return (KJSorcery5EAlterSelf() | SpellId('Shout_FlameBlade') | SpellId('Target_FlamingSphere') | SpellId('Target_MagicWeapon') | SpellId('Zone_AganazzarsScorcher') | SpellId('Shout_AlterSelf') | SpellId('Target_DragonsBreath') | SpellId('Target_DragonsBreath_Poison') | SpellId('Target_DragonsBreath_Lightning') | SpellId('Target_DragonsBreath_Fire') | SpellId('Target_DragonsBreath_Acid') | SpellId('Target_DragonsBreath_Cold') | SpellId('Target_DustDevil') | SpellId('Shout_KineticJaunt') | SpellId('Target_MindSpike') | SpellId('Target_MaximiliansEarthenGrasp') | SpellId('Target_TashasMindWhip') | SpellId('Target_NathairsMischief') | SpellId('Zone_RimesBindingIce') | SpellId('Target_SnillocsSnowballStorm') | SpellId('Target_VortexWarp') | SpellId('Shout_WardingWind') | SpellId('Target_WitherAndBloom') | SpellId('Shout_AbsorbElements') | SpellId('Shout_AbsorbElements_2') | SpellId('Throw_Catapult') | SpellId('Throw_Catapult_2') | SpellId('Target_ChaosBolt') | SpellId('Target_ChaosBolt_2') | SpellId('Shout_DetectMagic') | SpellId('Shout_DetectMagic_2') | SpellId('Shout_EarthTremor') | SpellId('Shout_EarthTremor_2') | SpellId('Zone_TashasCausticBrew') | SpellId('Zone_TashasCausticBrew_2'))
